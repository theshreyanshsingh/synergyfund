{
  "expo": {
    "name": "SynergiFund",
    "slug": "synergifund",
    "scheme": "synergifund",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#111111",
    "ios": {
      "bundleIdentifier": "com.synergifund.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "SynergiFund uses the camera for site photos, receipts and video calls.",
        "NSMicrophoneUsageDescription": "SynergiFund uses the microphone for calls and voice messages.",
        "NSPhotoLibraryUsageDescription": "SynergiFund lets you attach photos and files from your library.",
        "NSPhotoLibraryAddUsageDescription": "SynergiFund saves downloaded photos to your library when you ask it to.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.synergifund.app",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ]
  }
}
